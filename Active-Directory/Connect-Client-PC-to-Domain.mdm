Налаштування DNS
Set-DnsClientServerAddress -InterfaceIndex ((Get-NetAdapter).InterfaceIndex) -ServerAddresses ("172.16.19.101","8.8.8.8")

Ввод в домен
Enter-PSSession -VMName "W10-2" -Credential SH

$parameters = @{
    'DomainName' = 'studyposh.com';
    'NewName'    = 'SW10-02';
    'Credential' = 'STUDYPOSH\SH';
    'OUPath'     = 'OU=Teachers-Laptops,OU=Teachers,OU=Departments,DC=studyposh,DC=com'
}

Add-Computer @parameters -Restart -Force

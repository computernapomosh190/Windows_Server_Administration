Крок 1. Створення GPO та прив’язка до всього домену
# Імпорт модуля керування груповими політиками
Import-Module GroupPolicy

# 1. Створення нового об'єкта GPO
$GpoName = "Screen_Lock_Security_Policy"
New-GPO -Name $GpoName -Comment "Блокування екрана через 5 хвилин неактивності"

# 2. Отримання Distinguished Name (DN) поточного домену та прив'язка політики
$DomainDN = (Get-ADDomain).DistinguishedName
New-GPLink -Name $GpoName -Target $DomainDN -LinkEnabled Yes

Крок 2. Налаштування параметрів блокування екрана
Set-GPRegistryValue -Name $GpoName `
    -Key "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System" `
    -ValueName "InactivityTimeoutSecs" `
    -Type DWord `
    -Value 300

Варіант Б. На рівні користувача (класичний спосіб — через екранну заставку)
$UserRegPath = "HKCU\Software\Policies\Microsoft\Windows\Control Panel\Desktop"

# Увімкнути екранну заставку (Enable screen saver)
Set-GPRegistryValue -Name $GpoName -Key $UserRegPath -ValueName "ScreenSaveActive" -Type String -Value "1"

# Вимагати пароль при виході із заставки (Password protect the screen saver)
Set-GPRegistryValue -Name $GpoName -Key $UserRegPath -ValueName "ScreenSaverIsSecure" -Type String -Value "1"

# Час очікування в секундах (Screen saver timeout = 300 сек)
Set-GPRegistryValue -Name $GpoName -Key $UserRegPath -ValueName "ScreenSaveTimeOut" -Type String -Value "300"

Крок 3. Перевірка створеної політики та примусове оновлення
# Перевірити налаштовані параметри реєстру всередині GPO
Get-GPRegistryValue -Name $GpoName -Key "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System"

# Примусово оновити групові політики на віддаленому клієнтському ПК (замініть CLIENT01 на ім'я ПК)
Invoke-GPUpdate -Computer "CLIENT01" -Force

пошук подій у журналі Windows за допомогою складного XML-запиту (-FilterXml) із обмеженням кількості результатів.
# (вище в змінну $xmlFilter записано XML-запит із тегом <QueryList>...</QueryList>)
Get-WinEvent -FilterXml $xmlFilter -MaxEvents 50


Цей скрипт — аудит успішних входів конкретного користувача (ATuring) у систему за останні 30 днів.

$user = 'ATuring'
$startTime = (Get-Date).AddDays(-30)
Get-WinEvent -FilterHashtable @{
  LogName = 'Security';
  Id = '4624';
  Data = $user;
  StartTime = $startTime
}

вимірювання часу виконання запиту до журналу подій за допомогою командлета Measure-Command разом із повним кодом XML-фільтра.
Measure-Command -Expression {
$xmlFilter = @"
<QueryList>
  <Query Id="0" Path="Security">
    <Select Path="Security">
      *[System[(EventID=4624)]]
      and
      *[EventData[Data[@Name='TargetUserName'] and (Data='$($user)')]]
    </Select>
  </Query>
</QueryList>
"@
Get-WinEvent -FilterXml $xmlFilter
}


замір часу виконання вкладених циклів для масового пошуку входів кількох користувачів на різних віддалених серверах.
Measure-Command -Expression {
  $srvs = '://studyposh.com','://studyposh.com'
  foreach ($computer in $srvs) {
    $users = "ATuring", "SH"
    foreach ($user in $users) {
      Get-WinEvent -FilterHashtable @{
        LogName = 'Security'
        Id      = '4624'
        Data    = $user
      } -ComputerName $computer
    }
  }
}

Measure-Command -Expression {
  $srvs = '://studyposh.com','://studyposh.com'
  foreach ($computer in $srvs) {
    $users = "ATuring", "SH"
    foreach ($user in $users) {
      $xmlFilter = @"
<QueryList>
  <Query Id="0" Path="Security">
    <Select Path="Security">
      *[System[(EventID=4624)]]
      and
      *[EventData[Data[@Name='TargetUserName'] and (Data='$($user)')]]
    </Select>
  </Query>
</QueryList>
"@
      Get-WinEvent -FilterXml $xmlFilter -ComputerName $computer
    }
  }
}

